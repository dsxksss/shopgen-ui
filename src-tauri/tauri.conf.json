{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShopGen",
  "version": "0.1.0",
  "identifier": "com.shopgen.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ShopGen 智能电商运营中心",
        "width": 1540,
        "height": 960,
        "minWidth": 1200,
        "minHeight": 820,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}